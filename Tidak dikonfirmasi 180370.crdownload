IG_HASHTAGS = [
    "gempantt", "gempaflores", "gempamanggarai", "karhutla", "karhutlakalimantan", "kabutasap",
    "anakkrakatau", "erupsianakkrakatau", "banjirsumatra", "banjiraceh", "bnpb", "anggaranbnpb",
    "statusbencananasional", "longsorcisarua", "penanggulanganbencana",
]
# akun yang dominan pada data IG lama (unggahan dicek ulang relevansinya lewat caption)
IG_ACCOUNTS = [
    "bnpb_indonesia", "kemenhut", "bakom.ri", "kaltengpedia", "inilah_com", "kompascom", "metrotv",
    "kemenko_pmk", "birosuararakyat", "jawaposkalteng", "narasinewsroom", "cnnindonesia", "tempodotco",
]

# ---------------------------------------------------------------------------
# Relevansi konten: judul/caption harus menyebut bencana DAN penanganan/pemerintah
# ---------------------------------------------------------------------------
RE_DISASTER = re.compile(
    r"\bgempa(?!r)|karhutla|kebakaran hutan|kebakaran lahan|kabut asap|\berupsi|krakatau|vulkanik|banjir|longsor|"
    r"galodo|bencana|pengungsi|huntara|huntap|tsunami|mitigasi|\bbnpb|\bbpbd|puting beliung|kekeringan|titik api|hotspot|"
    r"manggala agni|pemadaman (api|kebakaran|karhutla|hutan|lahan)", re.I)
RE_HANDLING = re.compile(
    r"pemerintah|presiden|prabowo|gibran|wapres|menteri|mentan|mendagri|menhut|kemenhut|bnpb|bpbd|basarnas|"
    r"gubernur|bupati|pemda|pemkab|pemprov|dedi mulyadi|kdm|\btni\b|polri|polda|kodam|\bsar\b|anggaran|apbn|mbg|"
    r"bantuan|penanganan|tangani|evakuasi|tinjau|kunjung|status bencana|huntara|huntap|pemulihan|rekonstruksi|"
    r"relokasi|logistik|salurkan|distribusi|\bdpr\b|puan|kebijakan|instruksi|posko|satgas|damkar|pemadam|negara",
    re.I)
# bencana luar negeri (kecuali dibandingkan dengan Indonesia) dan peristiwa non-bencana alam
RE_FOREIGN = re.compile(
    r"nepal|colombia|kolombia|venezuela|myanmar|thailand|filipina|jepang|japan|turki|taiwan|tiongkok|\bchina\b|"
    r"\bindia\b|pakistan|afghanistan|maroko|amerika|\bas\b|rusia|ukraina|gaza|palestina|israel|iran|meksiko|"
    r"chile|vanuatu|malaysia|korea|hawaii|kanada|eropa", re.I)
RE_INDONESIA = re.compile(
    r"indonesia|\bri\b|prabowo|gibran|bnpb|bpbd|ntt|flores|aceh|sumatra|sumatera|kalimantan|jawa|jakarta|sulawesi|"
    r"papua|bali|lombok|krakatau|kemenhut|basarnas|dpr", re.I)
RE_NONDISASTER = re.compile(r"listrik|\bpln\b|jalan hancur|jalan rusak|kecelakaan|kapal .*tenggelam|kapal virgo|keracunan|tentara bayaran|penipuan|pinjol|judi", re.I)


# pemakaian kiasan / topik lain yang kebetulan memuat kata bencana -> selalu dibuang
RE_FALSE_FRIEND = re.compile(
    r"banjir (dikomentar|komentar|kritik|hujatan|pujian|pesanan|order)|dibanjiri|mitigasi (gelombang )?phk|"
    r"tanpa mitigasi|rawan korupsi|islam ala|nadiem", re.I)


def is_relevant(text: str) -> bool:
    t = text or ""
    if RE_FALSE_FRIEND.search(t):
        return False
    if not (RE_DISASTER.search(t) and RE_HANDLING.search(t)):
        return False
    if RE_FOREIGN.search(t) and not RE_INDONESIA.search(t):
        return False
    if RE_NONDISASTER.search(t) and not re.search(r"bencana|gempa|banjir|karhutla|erupsi|longsor|tsunami", t, re.I):
        return False
    return True


EVENT_RULES = [   # urutan penting: yang lebih spesifik dulu
    ("anggaran_kebijakan", r"anggaran|apbn|\bmbg\b|makan bergizi|status bencana nasional|dipangkas|efisiensi"),
    ("gempa_ntt", r"gempa.*(ntt|flores|manggarai|nagekeo|ende|sikka|kupang)|(ntt|flores|manggarai|nagekeo).*gempa|gempantt|gempaflores"),
    ("karhutla_kalimantan", r"karhutla|kebakaran hutan|kebakaran lahan|kabut asap|asap|manggala agni|pemadam.*hutan"),
    ("erupsi", r"\berupsi|krakatau|vulkanik|gunung api|meletus|letusan"),
    ("banjir_sumatra", r"banjir.*(sumatra|sumatera|aceh|sumut|sumbar|tapanuli|tapsel|tamiang|garoga)|(sumatra|sumatera|aceh).*(banjir|bencana|huntara|huntap)|banjirsumatra|banjiraceh"),
    ("lainnya", r"longsor|banjir|puting beliung|cisarua|tsunami"),
]


def assign_event(text: str) -> str:
    t = (text or "").lower()
    for ev, pat in EVENT_RULES:
        if re.search(pat, t):
            return ev
    return "umum"
