"""Konfigurasi bersama scraping v2 (YouTube + Instagram).

Revisi dosen:
  1. Dataset final = 2.500 komentar (1.250 YouTube + 1.250 Instagram).
  2. Hanya komentar dari akun dengan followers/subscriber > 1.000.
"""
import os
import re
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent      # folder Revisi_Data_2500
PROJECT = ROOT.parent                              # folder Project (data lama, .env)
OUT = ROOT / "scraping" / "data"
OUT.mkdir(parents=True, exist_ok=True)

MIN_FOLLOWERS = 1000            # syarat: followers/subscriber komentator > 1.000
TARGET_PER_PLATFORM = 1250
PERIOD_START = "2026-01-01"
PERIOD_END = "2026-09-30"       # komentar & konten dalam tahun anggaran berjalan (Jan–Sep 2026)
SEED = 42


def load_env():
    env = {}
    p = ROOT / ".env" if (ROOT / ".env").exists() else PROJECT / ".env"
    for line in p.read_text(encoding="utf-8").splitlines():
        if "=" in line and not line.strip().startswith("#"):
            k, v = line.split("=", 1)
            env[k.strip()] = v.strip().strip("\"'")
    os.environ.update(env)
    return env


# ---------------------------------------------------------------------------
